{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amadeus",
  "version": "0.1.4",
  "identifier": "app.amadeus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Amadeus",
        "width": 840,
        "height": 560,
        "center": true,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "titleBarStyle": "Transparent",
        "acceptFirstMouse": true,
        "devtools": true
      },
      {
        "label": "companion",
        "title": "Amadeus Companion",
        "url": "index.html?view=companion",
        "width": 40,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "titleBarStyle": "Transparent",
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "devtools": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://*.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": ["default", "companion"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["amadeus"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNTg4RkFCNjdENjc5Q0EKUldUS2VkWm5xNDlZUHd3V1ozU0tpdmQ5ejlYampodWxobG9LWmh6WGZ1ZEhHWGp1ZHpkV2tkbEYK",
      "endpoints": [
        "https://github.com/Amadeus-desktop/desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": true
  }
}
